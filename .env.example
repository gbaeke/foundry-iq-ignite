# Kestrel Graph Lab settings. Copy to .env (git ignores it) and adjust; every setting in config.py is listed here.
# infra/deploy.sh writes the Azure part for you.

# --- App ---------------------------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8318
# one JSON object per log line
LOG_JSON=false

# --- Azure -------------------------------------------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-foundry-iq-kg
# the Foundry IQ (Azure AI Search) service; Microsoft Retriever 1 needs a region that offers it (West US 3 here)
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_API_VERSION=2026-11-01-preview
STORAGE_ACCOUNT=
STORAGE_RESOURCE_ID=
CONTAINER_NAME=kestrel-corpus
# Azure OpenAI / Foundry resource with both deployments below
MODEL_ENDPOINT=https://<foundry-resource>.openai.azure.com
CHAT_DEPLOYMENT=gpt-5.6-luna
EMBEDDING_DEPLOYMENT=text-embedding-3-small
