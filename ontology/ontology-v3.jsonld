{"@context":{"owl":"http://www.w3.org/2002/07/owl#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@id":"https://schema.search.azure.com/entities#","@type":"owl:Ontology","owl:versionInfo":"kestrel-v3"},{"@id":"https://schema.search.azure.com/entities#Organization","@type":"owl:Class","rdfs:comment":"A company or organization: the consultancy Kestrel Consulting, one of its customers, or a subcontracting partner such as DataForge. Use the full legal or common name, e.g. 'Scaldis Logistics', not 'Scaldis'.","rdfs:label":"Organization"},{"@id":"https://schema.search.azure.com/entities#Person","@type":"owl:Class","rdfs:comment":"A named individual: a consultant, a customer contact or a partner employee. Resolve first names, initials and titles to the full name, e.g. 'KV' or 'Koen' to 'Koen Verstraete' only when the context makes it unambiguous.","rdfs:label":"Person"},{"@id":"https://schema.search.azure.com/entities#Place","@type":"owl:Class","rdfs:comment":"A city or country.","rdfs:label":"Place"},{"@id":"https://schema.search.azure.com/entities#Project","@type":"owl:Class","rdfs:comment":"A named engagement that the consultancy Kestrel Consulting delivered or is delivering for one customer, e.g. 'Claims Triage Automation'. Use the full project name without customer prefixes. Not a phase, sprint, product or workstream; 'Teams' or 'SharePoint' are technologies, not projects.","rdfs:label":"Project"},{"@id":"https://schema.search.azure.com/entities#Technology","@type":"owl:Class","rdfs:comment":"A named product, cloud service or platform used to build a solution, e.g. 'Azure AI Search', 'Databricks', 'Microsoft Fabric'.","rdfs:label":"Technology"},{"@id":"https://schema.search.azure.com/entities#contactFor","@type":"owl:ObjectProperty","rdfs:comment":"A customer employee involved in the project in another role than sponsor or product owner, e.g. IT manager, enterprise architect, security officer, data protection officer or OT engineer.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"contactFor","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Project"}},{"@id":"https://schema.search.azure.com/entities#deliveredBy","@type":"owl:ObjectProperty","rdfs:comment":"The consultancy that delivers the project: always Kestrel Consulting for projects in these documents.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"deliveredBy","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Organization"}},{"@id":"https://schema.search.azure.com/entities#deliveredFor","@type":"owl:ObjectProperty","rdfs:comment":"The CUSTOMER organization the project is delivered for (Scaldis Logistics, Mediva Care Group, Fortalis Verzekeringen, Verhaeghe Foods or AquaNova). Never Kestrel Consulting.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"deliveredFor","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Organization"}},{"@id":"https://schema.search.azure.com/entities#followsUp","@type":"owl:ObjectProperty","rdfs:comment":"The project is a follow-up or next phase of an earlier project.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"followsUp","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Project"}},{"@id":"https://schema.search.azure.com/entities#locatedIn","@type":"owl:ObjectProperty","rdfs:comment":"The city where the organization is based.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Organization"},"rdfs:label":"locatedIn","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Place"}},{"@id":"https://schema.search.azure.com/entities#managedProject","@type":"owl:ObjectProperty","rdfs:comment":"The person who is or was the project manager of the project.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"managedProject","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Project"}},{"@id":"https://schema.search.azure.com/entities#productOwnerOf","@type":"owl:ObjectProperty","rdfs:comment":"The customer-side product owner of the project.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"productOwnerOf","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Project"}},{"@id":"https://schema.search.azure.com/entities#sponsors","@type":"owl:ObjectProperty","rdfs:comment":"The customer-side executive sponsor of the project.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"sponsors","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Project"}},{"@id":"https://schema.search.azure.com/entities#subcontractedTo","@type":"owl:ObjectProperty","rdfs:comment":"A partner organization that delivered part of the project as a subcontractor.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"subcontractedTo","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Organization"}},{"@id":"https://schema.search.azure.com/entities#usesTechnology","@type":"owl:ObjectProperty","rdfs:comment":"A technology the project uses or used in its solution.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"usesTechnology","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Technology"}},{"@id":"https://schema.search.azure.com/entities#workedOn","@type":"owl:ObjectProperty","rdfs:comment":"A Kestrel Consulting consultant or a subcontractor employee who is or was on the delivery team of the project, in any role. Customer employees never have workedOn; they use sponsors, productOwnerOf or contactFor.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"workedOn","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Project"}},{"@id":"https://schema.search.azure.com/entities#worksFor","@type":"owl:ObjectProperty","rdfs:comment":"The person's employer. Kestrel consultants work for Kestrel Consulting; customer contacts work for the customer. A person can have different employers over time; extract each one.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"worksFor","rdfs:range":{"@id":"https://schema.search.azure.com/entities#Organization"}},{"@id":"https://schema.search.azure.com/entities#achieved","@type":"owl:DatatypeProperty","rdfs:comment":"A measurable result the project delivered, with its number, as a short phrase, e.g. '38% of claims auto-triaged' or '23 leaks detected'.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"achieved","rdfs:range":{"@id":"http://www.w3.org/2001/XMLSchema#string"}},{"@id":"https://schema.search.azure.com/entities#hadIssue","@type":"owl:DatatypeProperty","rdfs:comment":"A problem, blocker or risk that materially affected the project's schedule, cost or quality, as a short phrase, e.g. 'security review delayed go-live' or 'OT network access took 7 weeks'.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Project"},"rdfs:label":"hadIssue","rdfs:range":{"@id":"http://www.w3.org/2001/XMLSchema#string"}},{"@id":"https://schema.search.azure.com/entities#raisedIssue","@type":"owl:DatatypeProperty","rdfs:comment":"A problem, blocker or risk this person raised or imposed, as a short phrase, e.g. 'required document-level permission trimming'.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"raisedIssue","rdfs:range":{"@id":"http://www.w3.org/2001/XMLSchema#string"}},{"@id":"https://schema.search.azure.com/entities#resolvedIssue","@type":"owl:DatatypeProperty","rdfs:comment":"A problem or blocker this person resolved or worked around, as a short phrase, e.g. 'wrote deduplication rules for gate-in events'.","rdfs:domain":{"@id":"https://schema.search.azure.com/entities#Person"},"rdfs:label":"resolvedIssue","rdfs:range":{"@id":"http://www.w3.org/2001/XMLSchema#string"}}]}
